# ==============================================================================
# ZIMBANI PLATFORM - Production HTTPS / SSL Virtual Host Example
# ==============================================================================

server {
    listen 80;
    server_name app.fabhomesug.com client.fabhomesug.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.fabhomesug.com client.fabhomesug.com;
    root /var/www/html/public;

    # SSL Certificates (Let's Encrypt / Cloudflare)
    ssl_certificate /etc/letsencrypt/live/fabhomesug.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fabhomesug.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Strict Transport Security (HSTS)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # API Routing
    location ~ ^/(api|sanctum)/ {
        try_files $uri /index.php?$query_string;
        location ~ \.php$ {
            fastcgi_pass php_backend;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }
    }

    # WebSockets
    location /app/ {
        proxy_pass http://reverb_websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }

    # Frontend SPA
    location / {
        proxy_pass http://react_frontend;
    }
}
