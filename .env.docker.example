# ==============================================================================
# ZIMBANI PLATFORM - Production Docker Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME=ZIMBANI
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://app.fabhomesug.com

# In-Container Logging
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (Internal Docker Container Network)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=zimbani_prod
DB_USERNAME=zimbani_user
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASSWORD

# External Port Mappings
HTTP_PORT=80
HTTPS_PORT=443
DB_FORWARD_PORT=13306
REDIS_FORWARD_PORT=16379

# Redis Caching, Sessions & Queues
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Automated Migrations Flag (runs php artisan migrate on boot)
AUTORUN_MIGRATIONS=true

# Laravel Reverb WebSockets
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=zimbani-prod-app-id
REVERB_APP_KEY=zimbani-prod-app-key
REVERB_APP_SECRET=zimbani-prod-app-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# VITE Frontend Realtime Subscriptions
VITE_REVERB_APP_KEY=zimbani-prod-app-key
VITE_REVERB_HOST=app.fabhomesug.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Security & CORS
SANCTUM_STATEFUL_DOMAINS=app.fabhomesug.com,client.fabhomesug.com
SESSION_DOMAIN=.fabhomesug.com
